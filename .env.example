APP_ENV=development
DEV_MODE=true
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyayagraph
POSTGRES_USER=nyayagraph
# Development-only defaults. Production uses infra/compose.production.yml,
# which rejects missing secrets.
POSTGRES_PASSWORD=dev-only-postgres
DATABASE_URL=postgresql+psycopg2://nyayagraph:dev-only-postgres@postgres:5432/nyayagraph
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=dev-only-minio
MINIO_SECRET_KEY=dev-only-minio-secret
MINIO_BUCKET_EVIDENCE=evidence
MINIO_BUCKET_DOCUMENTS=documents
MINIO_SECURE=false
STORAGE_BACKEND=minio
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=nyayagraph
KEYCLOAK_CLIENT_ID=nyayagraph-web
KEYCLOAK_CLIENT_SECRET=
OIDC_ISSUER=http://localhost:8080/realms/nyayagraph
OIDC_JWKS_URL=http://keycloak:8080/realms/nyayagraph/protocol/openid-connect/certs
ENABLE_NEO4J=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dev-only-neo4j
AUTH_MODE=keycloak
DEMO_PASSWORD=NyayaDemo!2026
JWT_SECRET=
MASTER_KEK_BASE64=
KMS_PROVIDER=local
KMS_URL=
KMS_KEY_ID=
KMS_BEARER_TOKEN=
SIGNING_PRIVATE_KEY_PATH=
SIGNING_PUBLIC_KEY_PATH=
# LLM / AI
# Set LLM_PROVIDER=ollama to use Qwen3-8B via Ollama (recommended for SIH2026).
# Set LLM_PROVIDER=demo  to use the deterministic offline demo (no model needed).
# Set LLM_PROVIDER=openai_compatible for any OpenAI-compatible HTTP API.
LLM_PROVIDER=demo
# Ollama endpoint — used when LLM_PROVIDER=ollama.
# Ollama runs on the HOST machine, not inside Docker.
# When the API runs in Docker, use host.docker.internal instead of localhost.
OLLAMA_BASE_URL=http://localhost:11434
# Model tag served by Ollama.  Pull with: ollama pull qwen3:8b
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
# Used only when LLM_PROVIDER=openai_compatible.
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=demo
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_HOST=
MALWARE_SCAN_PORT=3310
FABRIC_ENABLED=false
FABRIC_CHANNEL=justicechannel
FABRIC_CHAINCODE=nyayagraph
FABRIC_PEER_BINARY=peer
FABRIC_MSP_ID=PoliceMSP
FABRIC_ORDERER_ADDRESS=orderer.example.com:7050
FABRIC_ORDERER_TLS_CA=/fabric/organizations/ordererOrganizations/example.com/tlsca/tlsca.example.com-cert.pem
FABRIC_PEER_ADDRESSES=peer0.org1.example.com:7051,peer0.org2.example.com:9051
FABRIC_PEER_TLS_ROOT_CERTS=/fabric/organizations/peerOrganizations/org1.example.com/tlsca/tlsca.org1.example.com-cert.pem,/fabric/organizations/peerOrganizations/org2.example.com/tlsca/tlsca.org2.example.com-cert.pem
CORE_PEER_TLS_ENABLED=true
CORE_PEER_LOCALMSPID=PoliceMSP
CORE_PEER_ADDRESS=peer0.org1.example.com:7051
CORE_PEER_TLS_ROOTCERT_FILE=/fabric/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
CORE_PEER_MSPCONFIGPATH=/fabric/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp
PUBLIC_CHAIN_MODE=local
PUBLIC_RPC_URL=http://hardhat:8545
PUBLIC_CHAIN_ID=31337
PUBLIC_ANCHOR_CONTRACT=
PUBLIC_ANCHOR_PRIVATE_KEY=
PUBLIC_ANCHOR_AUTHORITY=
IPFS_ENABLED=false
IPFS_API_URL=http://ipfs:5001
MAX_UPLOAD_BYTES=20971520
